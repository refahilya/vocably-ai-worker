{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vocably-ai-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",

  // Non-secret config. `OPENAI_API_KEY` itself is NOT here — it's a
  // secret, set via `npx wrangler secret put OPENAI_API_KEY` for the
  // deployed Worker, or `.dev.vars` (gitignored, see .dev.vars.example)
  // for `wrangler dev`.
  //
  // Reusing the same OpenAI-compatible endpoint/model already proven by
  // the Flutter repo's `tools/vocab_import` pipeline (DATA_MODEL.md §10),
  // per the project owner's explicit decision.
  "vars": {
    "OPENAI_BASE_URL": "https://ai.dinoiki.com/v1",
    "OPENAI_API_PATH": "/chat/completions",
    "OPENAI_MODEL": "gpt-4o-mini",
    "FIREBASE_PROJECT_ID": "vocably-idn-en",
    // Comma-separated allowlist (DATA_MODEL.md §10.1) — a fixed, explicit
    // list of exact origins, never a wildcard, so this stays safe to
    // deploy as-is.
    //
    // Corrected after a real end-to-end test: this used to be prod-only,
    // with `http://localhost:5555` added under a separate `env.development`
    // block on the assumption that local Flutter dev would always talk to
    // a *locally-running* `wrangler dev` Worker. In practice, the actual
    // dev workflow points the local Flutter client straight at this
    // deployed Worker (`--dart-define=WORKER_BASE_URL=https://vocably-ai-
    // worker.<subdomain>.workers.dev`) — and a plain `wrangler deploy`
    // only ever reads these top-level `vars`, never `env.development`'s.
    // So the deployed Worker's allowlist genuinely didn't include
    // localhost, and correctly rejected it (missing
    // `Access-Control-Allow-Origin` on the OPTIONS preflight, which is
    // exactly the browser error this fixes) — not a bug in the origin-
    // matching code itself (`src/cors.ts` was, and still is, unchanged).
    // Fix: `http://localhost:5555` now lives directly in this one list,
    // which is what's actually live. It's a single fixed origin, not a
    // pattern/wildcard, so this doesn't open the Worker to arbitrary
    // origins — anything not in this exact list is still rejected.
    "ALLOWED_ORIGINS": "https://vocably-idn-en.web.app,https://vocably-idn-en.firebaseapp.com,http://localhost:5555"
  }

  // --- Native rate limiting (DATA_MODEL.md §10.1) ---
  // Left out for now: it's uncertain whether the Rate Limiting binding is
  // available on the Workers Free plan (couldn't be confirmed from
  // Cloudflare's docs during planning). The code in src/rateLimit.ts
  // auto-detects this binding and falls back to a zero-cost in-memory
  // per-isolate limiter when it's absent — see that file's doc comment.
  //
  // Once you've confirmed Rate Limiting is available on your account's
  // plan, add this block as a top-level sibling of "vars" above (no code
  // changes needed — the fallback switches itself off automatically once
  // the binding exists):
  //
  //   "unsafe": {
  //     "bindings": [
  //       {
  //         "name": "RATE_LIMITER",
  //         "type": "ratelimit",
  //         "namespace_id": "1001",
  //         "simple": { "limit": 30, "period": 60 }
  //       }
  //     ]
  //   }
}
